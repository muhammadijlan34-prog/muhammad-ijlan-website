/* =========================================
   MUHAMMAD IJLAN
   FINAL LAUNCH READY STYLE.CSS
   PART 1
========================================= */

/* RESET */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:'Poppins',sans-serif;
    background:#F7FAFF;
    color:#111827;
    overflow-x:hidden;
    line-height:1.6;
}

/* LINKS */

a{
    text-decoration:none;
    color:inherit;
}

img{
    max-width:100%;
    display:block;
}

/* PRELOADER */

#preloader{

    position:fixed;

    inset:0;

    background:#F7FAFF;

    display:flex;

    justify-content:center;

    align-items:center;

    z-index:9999;

    transition:.6s;

}

#preloader img{

    width:120px;

    animation:logoPulse 1.4s ease infinite;

}

@keyframes logoPulse{

    0%{
        transform:scale(.92);
        opacity:.8;
    }

    50%{
        transform:scale(1);
        opacity:1;
    }

    100%{
        transform:scale(.92);
        opacity:.8;
    }

}

/* INSTALL BUTTON */

#installBtn{

    position:fixed;

    right:20px;

    bottom:20px;

    z-index:900;

    background:#0F4C81;

    color:#fff;

    border:none;

    padding:14px 22px;

    border-radius:50px;

    cursor:pointer;

    font-weight:600;

    box-shadow:0 12px 30px rgba(15,76,129,.25);

    transition:.35s;

}

#installBtn:hover{

    transform:translateY(-3px);

}

/* NAVBAR */

.navbar{

    position:sticky;

    top:0;

    z-index:999;

    background:#ffffffee;

    backdrop-filter:blur(14px);

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:14px 8%;

    box-shadow:0 5px 20px rgba(0,0,0,.05);

}

.logo img{

    width:60px;

}

.nav-links{

    display:flex;

    gap:28px;

    list-style:none;

}

.nav-links a{

    font-weight:600;

    color:#0F4C81;

    transition:.3s;

}

.nav-links a:hover{

    color:#2563EB;

}

/* HERO */

.hero{

    position:relative;

    overflow:hidden;

    min-height:92vh;

    display:flex;

    justify-content:center;

    align-items:center;

    text-align:center;

    padding:100px 20px;

    background:#F7FAFF;

}

.overlay{

    position:absolute;

    inset:0;

    background:linear-gradient(to bottom,
    rgba(255,255,255,.05),
    rgba(247,250,255,.6));

}

.hero-content{

    position:relative;

    z-index:5;

    max-width:900px;

    animation:heroFade 1s ease;

}

@keyframes heroFade{

    from{

        opacity:0;

        transform:translateY(35px);

    }

    to{

        opacity:1;

        transform:none;

    }

}

/* HERO LOGO */

.hero-logo{

    width:110px;

    margin:0 auto 25px;

}
/* HERO TITLE */

.hero h1{

    position:relative;

    display:inline-block;

    font-size:clamp(2.8rem,7vw,5rem);

    color:#0F4C81;

    font-weight:700;

    letter-spacing:2px;

    margin-bottom:15px;

    overflow:hidden;

}

/* Shine Animation */

.hero h1::after{

    content:"";

    position:absolute;

    top:0;

    left:-80%;

    width:50%;

    height:100%;

    background:linear-gradient(
        120deg,
        transparent,
        rgba(255,255,255,.85),
        transparent
    );

    animation:shine 4s linear infinite;

}

@keyframes shine{

    100%{

        left:140%;

    }

}

.tagline{

    font-size:1.3rem;

    font-weight:600;

    color:#111827;

    margin-bottom:10px;

}

.subtitle{

    font-size:1rem;

    color:#555;

    margin-bottom:35px;

}

/* Voice Wave */

.voice-wave{

    position:absolute;

    bottom:0;

    left:0;

    width:100%;

    height:180px;

    fill:none;

    stroke:#3B82F6;

    stroke-width:3;

    opacity:.45;

}

.voice-wave path{

    animation:waveMove 8s linear infinite;

}

@keyframes waveMove{

    0%{

        transform:translateX(0);

    }

    50%{

        transform:translateX(-40px);

    }

    100%{

        transform:translateX(0);

    }

}

/* BUTTONS */

.whatsapp-btn,
.about-btn,
.social-btn,
.contact-btn{

    display:inline-block;

    background:#0F4C81;

    color:#fff;

    padding:14px 28px;

    border-radius:50px;

    font-weight:600;

    transition:.35s;

    box-shadow:0 12px 28px rgba(15,76,129,.20);

}

.whatsapp-btn:hover,
.about-btn:hover,
.social-btn:hover,
.contact-btn:hover{

    background:#2563EB;

    transform:translateY(-4px);

}

/* COMMON SECTION */

section{

    padding:90px 8%;

}

section h2{

    text-align:center;

    color:#0F4C81;

    font-size:2.1rem;

    margin-bottom:45px;

}

/* CARDS */

.cards{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));

    gap:28px;

}

.card{

    position:relative;

    background:#fff;

    padding:30px;

    border-radius:20px;

    text-align:center;

    overflow:hidden;

    box-shadow:0 12px 30px rgba(0,0,0,.08);

}

.card::before{

    content:"";

    position:absolute;

    inset:-2px;

    border-radius:20px;

    background:linear-gradient(
        90deg,
        #0F4C81,
        #3B82F6,
        #0F4C81
    );

    background-size:300%;

    animation:borderMove 4s linear infinite;

    z-index:-1;

}

@keyframes borderMove{

    100%{

        background-position:300%;

    }

}

.card h3{

    color:#0F4C81;

    margin-bottom:15px;

}

.card p{

    color:#555;

    font-size:.97rem;

}
/* =========================================
   FOLLOW ME
========================================= */

.social-grid{

    display:grid;

    grid-template-columns:repeat(2,1fr);

    gap:25px;

}

.social-card{

    position:relative;

    background:#fff;

    border-radius:20px;

    padding:30px;

    text-align:center;

    overflow:hidden;

    box-shadow:0 12px 30px rgba(0,0,0,.08);

}

.social-card::before{

    content:"";

    position:absolute;

    inset:-2px;

    border-radius:20px;

    background:linear-gradient(
        90deg,
        #0F4C81,
        #3B82F6,
        #0F4C81
    );

    background-size:300%;

    animation:borderMove 4s linear infinite;

    z-index:-1;

}

.social-icon{

    font-size:45px;

    color:#0F4C81;

    margin-bottom:18px;

}

.social-card h3{

    color:#0F4C81;

    margin-bottom:10px;

}

.social-card p{

    color:#666;

    margin-bottom:20px;

}

.qr-image{

    width:130px;

    margin:15px auto 20px;

}

/* CONTACT */

.contact{

    text-align:center;

}

.contact-buttons{

    display:flex;

    justify-content:center;

    gap:20px;

    flex-wrap:wrap;

    margin-top:30px;

}

/* FOOTER */

.footer{

    background:#0F4C81;

    color:#fff;

    text-align:center;

    padding:35px 20px;

}

.footer p{

    margin:8px 0;

}

/* RESPONSIVE */

@media(max-width:768px){

    .navbar{

        flex-direction:column;

        gap:18px;

    }

    .nav-links{

        gap:18px;

        flex-wrap:wrap;

        justify-content:center;

    }

    .hero{

        min-height:88vh;

        padding:90px 20px;

    }

    .hero-logo{

        width:90px;

    }

    .hero h1{

        font-size:2.5rem;

        line-height:1.15;

    }

    .tagline{

        font-size:1.05rem;

    }

    .subtitle{

        font-size:.95rem;

    }

    .social-grid{

        grid-template-columns:1fr 1fr;

        gap:18px;

    }

    section{

        padding:70px 20px;

    }

}

@media(max-width:520px){

    .social-grid{

        grid-template-columns:1fr;

    }

}